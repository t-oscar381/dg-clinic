# Set in Vercel once the production domain is known.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (CMS: site content + blog/news, admin auth) --------------
# Project: "WhatsApp AI Medical Assistant" (also hosts the dg-clinic-bot
# patient tables — those stay isolated via RLS from the CMS admin login,
# see the create_cms_content_and_posts migration).
NEXT_PUBLIC_SUPABASE_URL=https://zkivvqugzehdbytuhnkv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. Only used server-side (Instagram
# cron/sync routes, the admin on-demand sync trigger). Never expose to
# the browser, never prefix with NEXT_PUBLIC_. Dashboard → Settings →
# API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Instagram feed (@dg.clinic.hnw) — docs/HANDOFF-instagram-feed.md --
# Ships with the feed off (INSTAGRAM_FEED_ENABLED unset/false); the
# component falls back to the static grid until all of these are set.
# See docs/HANDOFF-instagram-feed.md §0 for how to obtain each value —
# short version: Meta app with the *Instagram* product (Instagram API
# with Instagram Login, not the retired Basic Display), then run the
# OAuth flow once at /api/instagram/oauth/start while signed into
# /dgc-master as an admin.

# From the Meta app's Basic Settings.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Bootstrap-only fallback for the very first sync, before the OAuth flow
# has ever run — after that, the live token lives in the Supabase
# integration_tokens table and this var is no longer read. Safe to leave
# blank once OAuth has run once.
INSTAGRAM_LONG_LIVED_TOKEN=

# Printed by /api/instagram/oauth/callback after the first OAuth
# exchange — copy it in from there.
INSTAGRAM_USER_ID=

# Kill switch. Feed renders the static fallback grid whenever this
# isn't exactly "true" — no redeploy-free toggle exists yet (would need
# a DB-backed flag like SEO_INDEXING_ENABLED's pattern; not built here
# since credentials aren't live yet either).
INSTAGRAM_FEED_ENABLED=false

# Guards /api/instagram/sync and /api/instagram/refresh-token. Generate
# a long random value (e.g. `openssl rand -hex 32`) — Vercel Cron sends
# it automatically as `Authorization: Bearer $CRON_SECRET` once this is
# set, and the same value works for manual curl testing.
CRON_SECRET=

# --- Payments (Xendit, payment-link model) ----------------------------
# Framework ships disabled; set to "true" per environment once the
# Xendit keys below are configured.
PAYMENTS_ENABLED=false

# Xendit secret API key (Dashboard → Settings → Developers → API keys).
# Use the test key (xnd_development_...) outside production.
XENDIT_SECRET_KEY=

# Callback verification token (Dashboard → Settings → Developers →
# Callbacks). Used to authenticate webhook requests from Xendit.
XENDIT_WEBHOOK_TOKEN=

# Shared secret for the internal create-link endpoint. Generate a long
# random value (e.g. `openssl rand -hex 32`).
PAYMENTS_ADMIN_TOKEN=

# --- Paper.id (intended financial/invoicing partner, not connected yet)
# PAPERID_API_KEY=

# --- Admin finance simulator (/admin/finance-simulator) ----------------
# Speed-bump passcode only, not real security — the page never touches
# real money or real Paper.id credentials. Defaults to "dgclinic-demo"
# if unset. Change per environment if you want a different passcode.
NEXT_PUBLIC_ADMIN_SIM_PASSCODE=dgclinic-demo

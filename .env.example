# Set in Vercel once the production domain is known.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (CMS: site content + blog/news, admin auth) --------------
# Project: "WhatsApp AI Medical Assistant" (also hosts the dg-clinic-bot
# patient tables — those stay isolated via RLS from the CMS admin login,
# see the create_cms_content_and_posts migration).
NEXT_PUBLIC_SUPABASE_URL=https://zkivvqugzehdbytuhnkv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Payments (Xendit, payment-link model) ----------------------------
# Framework ships disabled; set to "true" per environment once the
# Xendit keys below are configured.
PAYMENTS_ENABLED=false

# Xendit secret API key (Dashboard → Settings → Developers → API keys).
# Use the test key (xnd_development_...) outside production.
XENDIT_SECRET_KEY=

# Callback verification token (Dashboard → Settings → Developers →
# Callbacks). Used to authenticate webhook requests from Xendit.
XENDIT_WEBHOOK_TOKEN=

# Shared secret for the internal create-link endpoint. Generate a long
# random value (e.g. `openssl rand -hex 32`).
PAYMENTS_ADMIN_TOKEN=

# --- Paper.id (intended financial/invoicing partner, not connected yet)
# PAPERID_API_KEY=

# --- Admin finance simulator (/admin/finance-simulator) ----------------
# Speed-bump passcode only, not real security — the page never touches
# real money or real Paper.id credentials. Defaults to "dgclinic-demo"
# if unset. Change per environment if you want a different passcode.
NEXT_PUBLIC_ADMIN_SIM_PASSCODE=dgclinic-demo
